---
import BaseLayout from './BaseLayout.astro';

interface Props {
  title: string;
  subtitle?: string;
  description?: string;
}
const { title, subtitle, description } = Astro.props;
---

<BaseLayout title={title} description={description}>
  <section class="border-b border-slate-200 bg-gradient-to-b from-brand-50/60 to-white dark:border-slate-800 dark:from-brand-950/30 dark:to-slate-950">
    <div class="mx-auto max-w-3xl px-4 py-14 sm:px-6">
      <h1 class="font-serif text-4xl font-bold tracking-tight text-slate-900 dark:text-white">
        {title}
      </h1>
      {
        subtitle && (
          <p class="mt-3 text-lg text-slate-600 dark:text-slate-400">{subtitle}</p>
        )
      }
    </div>
  </section>

  <div class="mx-auto max-w-3xl px-4 py-12 sm:px-6">
    <div class="prose-journal">
      <slot />
    </div>
  </div>
</BaseLayout>
