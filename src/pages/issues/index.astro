---
import BaseLayout from '../../layouts/BaseLayout.astro';
import IssueCard from '../../components/IssueCard.astro';
import { getIssues, getArticlesForIssue } from '../../lib/content';

const issues = await getIssues();

// Pair each issue with its article count, then group by volume for display.
const withCounts = await Promise.all(
  issues.map(async (issue) => ({
    issue,
    count: (await getArticlesForIssue(issue.id)).length,
  })),
);

const byVolume = new Map<number, typeof withCounts>();
for (const entry of withCounts) {
  const vol = entry.issue.data.volume;
  if (!byVolume.has(vol)) byVolume.set(vol, []);
  byVolume.get(vol)!.push(entry);
}
const volumes = [...byVolume.keys()].sort((a, b) => b - a);
---

<BaseLayout
  title="Issues"
  description="Browse all published issues and volumes of IJATS."
>
  <section class="border-b border-slate-200 bg-gradient-to-b from-brand-50/60 to-white dark:border-slate-800 dark:from-brand-950/30 dark:to-slate-950">
    <div class="mx-auto max-w-6xl px-4 py-14 sm:px-6">
      <h1 class="font-serif text-4xl font-bold tracking-tight text-slate-900 dark:text-white">
        Issues &amp; Archive
      </h1>
      <p class="mt-3 max-w-2xl text-lg text-slate-600 dark:text-slate-400">
        Every published edition of the journal, newest first.
      </p>
    </div>
  </section>

  <div class="mx-auto max-w-6xl px-4 py-12 sm:px-6">
    {
      volumes.length === 0 ? (
        <div class="rounded-xl border border-dashed border-slate-300 bg-slate-50 p-12 text-center dark:border-slate-700 dark:bg-slate-900/40">
          <p class="text-lg text-slate-600 dark:text-slate-400">
            No issues have been published yet.
          </p>
          <a href="/call-for-papers" class="mt-3 inline-block font-medium text-brand-600 hover:underline dark:text-brand-300">
            View the Call for Papers →
          </a>
        </div>
      ) : (
        <div class="space-y-14">
          {volumes.map((vol) => (
            <section>
              <h2 class="mb-5 font-serif text-xl font-bold text-slate-900 dark:text-white">
                Volume {vol}
              </h2>
              <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
                {byVolume
                  .get(vol)!
                  .sort((a, b) => b.issue.data.issue - a.issue.data.issue)
                  .map(({ issue, count }) => (
                    <IssueCard issue={issue} articleCount={count} />
                  ))}
              </div>
            </section>
          ))}
        </div>
      )
    }
  </div>
</BaseLayout>
