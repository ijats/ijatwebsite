---
import type { GetStaticPaths } from 'astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import ArticleItem from '../../components/ArticleItem.astro';
import PdfButton from '../../components/PdfButton.astro';
import { getIssues, getArticlesForIssue, issueLabel, formatDate } from '../../lib/content';

export const getStaticPaths = (async () => {
  const issues = await getIssues();
  return issues.map((issue) => ({
    params: { slug: issue.id },
    props: { issue },
  }));
}) satisfies GetStaticPaths;

const { issue } = Astro.props;
const articles = await getArticlesForIssue(issue.id);
const label = issueLabel(issue);
---

<BaseLayout
  title={issue.data.title ?? label}
  description={issue.data.summary ?? `${label} of IJATS.`}
>
  <section class="border-b border-slate-200 bg-gradient-to-b from-brand-50/60 to-white dark:border-slate-800 dark:from-brand-950/30 dark:to-slate-950">
    <div class="mx-auto max-w-4xl px-4 py-14 sm:px-6">
      <nav class="text-sm text-slate-500 dark:text-slate-400">
        <a href="/issues" class="hover:text-brand-600 dark:hover:text-brand-300">Issues</a>
        <span class="mx-2">/</span>
        <span>{label}</span>
      </nav>
      <h1 class="mt-3 font-serif text-4xl font-bold tracking-tight text-slate-900 dark:text-white">
        {issue.data.title ?? label}
      </h1>
      <p class="mt-2 text-slate-600 dark:text-slate-400">
        {label} · Published {formatDate(issue.data.publishDate)}
      </p>
      {
        issue.data.summary && (
          <p class="mt-4 max-w-2xl text-slate-600 dark:text-slate-300">
            {issue.data.summary}
          </p>
        )
      }
      {
        issue.data.fullIssuePdf && (
          <div class="mt-6">
            <PdfButton href={issue.data.fullIssuePdf} label="Download full issue (PDF)" variant="solid" />
          </div>
        )
      }
    </div>
  </section>

  <div class="mx-auto max-w-4xl px-4 py-10 sm:px-6">
    <h2 class="font-serif text-xl font-bold text-slate-900 dark:text-white">
      Table of Contents
    </h2>
    {
      articles.length === 0 ? (
        <p class="mt-4 text-slate-600 dark:text-slate-400">
          Articles for this issue are being finalised.
        </p>
      ) : (
        <div class="mt-2 divide-y divide-slate-200 dark:divide-slate-800">
          {articles.map((article) => (
            <ArticleItem article={article} />
          ))}
        </div>
      )
    }
  </div>
</BaseLayout>
