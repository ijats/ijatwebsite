---
import { journal, navLinks } from '../lib/journal';
const year = new Date().getFullYear();
---

<footer class="mt-20 border-t border-slate-200 bg-slate-50 dark:border-slate-800 dark:bg-slate-900/40">
  <div class="mx-auto grid max-w-6xl gap-8 px-4 py-12 sm:px-6 md:grid-cols-3">
    <div>
      <div class="flex items-center gap-3">
        <img src="/logo.svg" alt="" class="h-8 w-8" width="32" height="32" />
        <span class="font-serif text-base font-bold text-slate-900 dark:text-white">
          {journal.shortName}
        </span>
      </div>
      <p class="mt-3 max-w-xs text-sm text-slate-600 dark:text-slate-400">
        {journal.name}. Open access, peer-reviewed, and committed to real-world
        technological impact.
      </p>
      <p class="mt-3 text-xs text-slate-500 dark:text-slate-500">
        ISSN: {journal.issn}
      </p>
    </div>

    <div>
      <h2 class="text-xs font-semibold uppercase tracking-wider text-slate-500 dark:text-slate-400">
        Explore
      </h2>
      <ul class="mt-3 space-y-2 text-sm">
        {
          navLinks.map((link) => (
            <li>
              <a
                href={link.href}
                class="text-slate-600 hover:text-brand-600 dark:text-slate-400 dark:hover:text-brand-300"
              >
                {link.label}
              </a>
            </li>
          ))
        }
        <li>
          <a href="/editorial-policies" class="text-slate-600 hover:text-brand-600 dark:text-slate-400 dark:hover:text-brand-300">
            Editorial Policies
          </a>
        </li>
      </ul>
    </div>

    <div>
      <h2 class="text-xs font-semibold uppercase tracking-wider text-slate-500 dark:text-slate-400">
        Contact
      </h2>
      <ul class="mt-3 space-y-2 text-sm">
        <li>
          <span class="text-slate-500 dark:text-slate-500">General:</span>
          <a href={`mailto:${journal.email.general}`} class="text-brand-600 hover:underline dark:text-brand-300">
            {journal.email.general}
          </a>
        </li>
        <li>
          <span class="text-slate-500 dark:text-slate-500">Submissions:</span>
          <a href={`mailto:${journal.email.submissions}`} class="text-brand-600 hover:underline dark:text-brand-300">
            {journal.email.submissions}
          </a>
        </li>
      </ul>
    </div>
  </div>

  <div class="border-t border-slate-200 dark:border-slate-800">
    <div class="mx-auto max-w-6xl px-4 py-5 text-xs text-slate-500 sm:px-6 dark:text-slate-500">
      © {journal.startYear}–{year} {journal.name}. All rights reserved.
    </div>
  </div>
</footer>
