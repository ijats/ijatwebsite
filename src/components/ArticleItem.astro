---
import type { Article } from '../lib/content';
import { formatAuthors, pageRange } from '../lib/content';
import PdfButton from './PdfButton.astro';

interface Props {
  article: Article;
}
const { article } = Astro.props;
const pages = pageRange(article);
const href = `/articles/${article.id}`;
---

<article class="flex flex-col gap-3 py-6 sm:flex-row sm:items-start sm:justify-between sm:gap-6">
  <div class="min-w-0">
    <h3 class="font-serif text-lg font-semibold leading-snug text-slate-900 dark:text-white">
      <a href={href} class="hover:text-brand-700 dark:hover:text-brand-300">
        {article.data.title}
      </a>
    </h3>
    <p class="mt-1 text-sm text-slate-600 dark:text-slate-400">
      {formatAuthors(article.data.authors)}
    </p>
    {
      pages && (
        <p class="mt-1 text-xs text-slate-500 dark:text-slate-500">Pages {pages}</p>
      )
    }
  </div>
  <div class="flex shrink-0 items-center gap-2">
    <a
      href={href}
      class="text-sm font-medium text-slate-600 hover:text-brand-700 dark:text-slate-400 dark:hover:text-brand-300"
    >
      Abstract
    </a>
    <PdfButton href={article.data.pdf} label="PDF" />
  </div>
</article>
